<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="sessionSummary"
            type="mz.org.csaude.mentoring.model.session.SessionSummary" />
        <import type="mz.org.csaude.mentoring.util.Utilities"/>
        <import type="mz.org.csaude.mentoring.util.DateUtilities"/>
        <import type="android.view.View"/>
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp"
        bind:cardCornerRadius="@dimen/dimen_0dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <RelativeLayout
            android:id="@+id/sinais_vitais_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Título (esquerda) -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sinais_vitais_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{sessionSummary.title}"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <!-- SIM (logo abaixo do título, à esquerda) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/sim_status_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/sinais_vitais_title"
                android:minHeight="0dp"
                android:layout_marginTop="@dimen/dimen_4dp"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                android:padding="@dimen/dimen_m3dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Pill"
                app:cardBackgroundColor="@color/status_closed_bg">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/sim_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dimen_5dp"
                    android:text='@{Utilities.concatStrings(Utilities.parseIntToString(sessionSummary.simCount), "SIM", " - ")}'
                    android:textSize="14sp"
                    android:textColor="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- NÃO (abaixo de SIM, à esquerda) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nao_status_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/sim_status_card"
                android:minHeight="0dp"
                android:layout_marginTop="@dimen/dimen_4dp"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                android:padding="@dimen/dimen_m3dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Pill"
                app:cardBackgroundColor="@color/status_open_bg">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/nao_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text='@{Utilities.concatStrings(Utilities.parseIntToString(sessionSummary.naoCount), "NÃO", " - ")}'
                    android:textSize="14sp"
                    android:layout_marginHorizontal="@dimen/dimen_5dp"
                    android:textColor="?attr/colorError" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Indicador circular + percentagem (direita) -->
            <RelativeLayout
                android:id="@+id/progress_layout"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:indicatorSize="60dp"
                    app:trackThickness="6dp"
                    app:indicatorDirectionCircular="clockwise"
                    app:indicatorInset="6dp"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="@color/white"
                    app:progress="@{sessionSummary.progressPercentage}" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/progress_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text='@{Utilities.concatStrings(Utilities.parseIntToString(sessionSummary.progressPercentage), "%", "")}'
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </RelativeLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>
